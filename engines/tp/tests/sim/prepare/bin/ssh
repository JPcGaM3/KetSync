#!/usr/bin/env bash
# fake ssh — the whole cluster, one shell command at a time.
#
# ct-prepare.sh orchestrates and touches nothing itself, so every read and
# every write in the run arrives here. Two kinds of machine answer:
#
#   $SIM_BKP_HOST      the backup node, asked one question: which node holds
#                      the config for this container
#   anything else      a production node: its containers, its bridges, its
#                      storages, and the record in pmxcfs
#
# Four answers refuse to pretend rather than simulate, because each one has a
# consequence on a real machine that no amount of correct-looking log output
# would undo:
#
#   - pct set on a container whose storage ANSWERED  (P2: cuts a live customer
#     off their own network)
#   - pct start / stop / shutdown / destroy, anywhere, ever
#   - moving a bridge before the record exists       (the record is the only
#     copy of the bridge being overwritten)
#   - any write at all while --dry-run is in force
# shellcheck source=tests/sim/prepare/lib.sh
. "$SIMLIB"

host=""; ctl=""; declare -a cmd=()
while (( $# )); do
  case "$1" in
    -o) shift 2;;
    -O) ctl="${2:-}"; shift 2;;
    -c) shift 2;;
    -*) shift;;
    *)  if [[ -z "$host" ]]; then host="${1#*@}"; else cmd+=("$1"); fi; shift;;
  esac
done
[[ -n "$ctl" ]] && exit 0
c="${cmd[*]:-}"
trace "ssh $host :: $(printf '%s' "$c" | tr '\n' ' ')"

PVE="$SIMROOT/pve"

# Starting, creating and destroying are never this engine's to do, on any
# machine, ever. `pct stop` is not either: --evacuate asks a container to shut
# down and isolates the ones that will not, and there is no rung above that.
# The shutdown itself is handled further down, where the fake can check that
# the mount was dealt with first.
case "$c" in
  *"pct start"*|*"pct create"*|*"pct stop "*)
    violation "touched container lifecycle: $c"; exit 1;;
  # --cleanup --destroy may remove a 9<id>, and that is the ONLY destroy this
  # engine is allowed. The number is the whole permission: a production id
  # arriving here is the worst bug this repo could ship, so the fake refuses to
  # pretend rather than leaving it to an assertion somebody might not write.
  *"pct destroy"*)
    _did="${c##*pct destroy }"; _did="${_did%% *}"
    if [[ ! "$_did" =~ ^[0-9]+$ ]] || (( _did < 9000 )); then
      violation "destroyed CT $_did, which is not a 9<id>: $c"; exit 1
    fi;;
esac

# ---------------------------------------------------------------- backup node
if [[ "$host" == "${SIM_BKP_HOST:-}" ]]; then
  [[ -f "$SIMROOT/bkp.down" ]] && { echo "ssh: connect to host $host port 22: No route to host" >&2; exit 255; }
  case "$c" in
    "ls /etc/pve/"*)
      a="${c#ls }"; a="${a%%2>*}"
      set -f; read -r -a pats <<<"$a"; set +f
      found=0
      for pat in "${pats[@]}"; do
        [[ "$pat" == -* ]] && continue
        # shellcheck disable=SC2206  # the glob is the point: /etc/pve/nodes/*/lxc
        hits=( "$PVE"${pat#/etc/pve} )
        for f in "${hits[@]}"; do
          [[ -e "$f" ]] || continue
          printf '/etc/pve%s\n' "${f#"$PVE"}"; found=1
        done
      done
      (( found )) || { echo "ls: cannot access: No such file or directory" >&2; exit 2; }
      exit 0;;
    true) exit 0;;
  esac
  violation "remote command the simulator does not model on the backup node: $c"
  exit 1
fi

# ---------------------------------------------------------------- production
N="$(node_dir "$host")"
if [[ ! -d "$N" && -f "$SIMWORK/nodes.map" ]]; then
  _n="$(awk -v i="$host" '$1!~/^#/ && $1==i{print $2; exit}' "$SIMWORK/nodes.map")"
  [[ -n "$_n" ]] && N="$(node_dir "$_n")"
fi
[[ -d "$N" && ! -f "$N/.down" ]] \
  || { echo "ssh: connect to host $host port 22: No route to host" >&2; exit 255; }
NODE="$(basename "$N")"
D="$N/ct"

case "$c" in
  true) exit 0;;

  # ---- the probe. One round trip, reproduced as the engine's snippet behaves,
  # including the part that matters: a missing bridge exits BEFORE it can echo
  # OK, so "could not finish reading" stays apart from "there is no uplink".
  *"/sys/class/net/veth"*)
    flat="$(printf '%s' "$c" | tr '\n' ' ')"
    id="$(sed -n 's|.*/sys/class/net/veth\([0-9][0-9]*\)i\*.*|\1|p' <<<"$flat")"
    br="$(sed -n 's|.*ip -br link show \([^ ]*\).*|\1|p' <<<"$flat")"
    [[ -f "$D/$id.status" ]] || { echo NOCONFIG; exit 0; }
    printf 'STATUS %s\n' "$(cat "$D/$id.status")"
    printf 'ONBOOT %s\n' "$(cat "$D/$id.onboot" 2>/dev/null || echo 0)"
    printf 'NETS %s\n'   "$(grep -c . "$D/$id.nets" 2>/dev/null || echo 0)"
    if [[ -f "$D/$id.nets" ]]; then
      while IFS= read -r l; do
        [[ -n "$l" ]] || continue
        printf 'NETLINE %s %s\n' "${l%%:*}" "${l#*: }"
      done < "$D/$id.nets"
    fi
    sid="$(cat "$D/$id.rootsid" 2>/dev/null)"
    printf 'ROOTSID %s\n' "$sid"
    printf 'ROOTPATH %s\n' "$(cat "$N/storage/$sid.path" 2>/dev/null || echo "/mnt/pve/$sid")"
    printf 'STATRC %s\n' "$(stat_rc_of "$NODE" "$sid")"
    printf 'DSTATE %s\n' "$(cat "$N/dstate" 2>/dev/null || echo 0)"
    # The KERNEL's view, kept separate from the config's on purpose: a config
    # can record a bridge change PVE never applied to a running container, and
    # P6 is the guard that exists because of it.
    #
    # On an OVS node the kernel's answer is ovs-system for every interface -
    # the datapath, not the bridge - and the bridge is only in ovsdb. That is
    # modelled as two separate facts, because it IS two separate facts: the
    # node's ovs map is answered only when the probe actually asks ovs-vsctl.
    # A probe that stops asking gets ovs-system and nothing else, which is what
    # the engine on this fleet was seeing.
    if [[ -f "$D/$id.veth" ]]; then
      while read -r ifn master; do
        [[ -n "${ifn:-}" ]] || continue
        printf 'VETH %s %s\n' "$ifn" "$master"
        if [[ "$flat" == *iface-to-br* ]]; then
          b="$(awk -v i="$ifn" '$1==i{print $2; exit}' "$N/ovs" 2>/dev/null)"
          [[ -n "$b" ]] && printf 'OVSBR %s %s\n' "$ifn" "$b"
        fi
      done < "$D/$id.veth"
    fi
    [[ -f "$N/bridges/$br" ]] || { echo BRMISSING; exit 0; }
    while read -r port kind members; do
      [[ -z "${port:-}" ]] && continue
      # An OVS bond is one PORT with no kernel netdev of its own; its members
      # are the NICs. `list-ports` names the bond and the engine's test for a
      # physical device finds nothing - so a bridge with a bonded uplink reads
      # as isolated. `list-ifaces` returns the members. The fake answers the
      # two differently because ovs-vsctl does.
      if [[ "$kind" == ovsbond ]]; then
        [[ "$flat" == *list-ifaces* ]] || continue
        for m in ${members//,/ }; do printf 'UPLINK %s\n' "$m"; done
        continue
      fi
      case "$kind" in nic|bond) printf 'UPLINK %s\n' "$port";; esac
    done < "$N/bridges/$br"
    echo OK; exit 0;;

  *"readlink /etc/pve/local"*) printf '%s\n' "$NODE"; exit 0;;

  # ---- what --evacuate does to a node ------------------------------------
  "pvesm set "*--disable*)
    dry_forbids "changed a storage's enabled flag" || exit 1
    sid="$(awk '{print $3}' <<<"$c")"
    v="$(sed -n 's/.*--disable \([01]\).*/\1/p' <<<"$c")"
    [[ -f "$N/storage/$sid.verdict" ]] || { echo "storage '$sid' does not exist" >&2; exit 255; }
    # storage.cfg is pmxcfs: disabling is cluster-wide, so the flag is stored
    # once and every node sees it. A per-node flag would let a scenario pass
    # while the real thing took a storage away from machines nobody asked about.
    if [[ "$v" == 1 ]]; then : > "$PVE/storage-$sid.disabled"; else rm -f "$PVE/storage-$sid.disabled"; fi
    exit 0;;

  "umount -f -l "*)
    dry_forbids "unmounted a storage" || exit 1
    p="${c#umount -f -l }"; p="${p//\'/}"
    sid="${p##*/}"
    [[ -f "$N/storage/$sid.verdict" ]] || { echo "umount: $p: not mounted" >&2; exit 32; }
    if [[ "$(storage_verdict_of "$NODE" "$sid")" == alive ]]; then
      violation "unmounted '$sid' on $NODE while it was ALIVE - every container on it loses its disk"
      exit 1
    fi
    : > "$N/storage/$sid.unmounted"
    exit 0;;

  "systemctl restart pvestatd"*) exit 0;;

  # A container whose dead rootfs is STILL MOUNTED has its processes in
  # uninterruptible sleep: pct shutdown waits for a guest that cannot answer
  # and `timeout` kills the wait. Unmount first and the same command returns.
  # That causal chain is the reason evacuate does things in the order it does,
  # and modelling it here is what makes the order testable.
  *"pct shutdown "*)
    dry_forbids "stopped a container" || exit 1
    # A real Ctrl-C, at a known moment. The engine's own PID is in engine.pid
    # because the harness starts it in the background for exactly this: from
    # inside a command substitution the fake cannot work out which process up
    # the chain is the engine, and signalling the wrong one would prove
    # nothing. One scenario arms this; every other run never reads the file.
    if [[ -f "$SIMROOT/.interrupt" ]]; then
      rm -f "$SIMROOT/.interrupt"
      kill -INT "$(cat "$SIMROOT/engine.pid" 2>/dev/null)" 2>/dev/null
      sleep 1
    fi
    id="${c##*pct shutdown }"; id="${id%% *}"
    [[ -f "$D/$id.status" ]] || { echo "Configuration file 'lxc/$id.conf' does not exist" >&2; exit 2; }
    # A 9<id> is the container standing in for production, on local storage
    # that is alive by definition - the rules below are about the production
    # container whose disk has gone, and they do not fit it. Its own rule is
    # that stopping it while production is not running is an outage caused by
    # the tidy-up, which is worse than leaving it up.
    if (( id >= 9000 )); then
      _prod=$(( id - 9000 )); _pst=""
      for _pd in "$SIMROOT"/nodes/*/ct/"$_prod.status"; do
        [[ -f "$_pd" ]] && _pst="$(cat "$_pd")"
      done
      if [[ "$_pst" != running ]]; then
        violation "stopped CT $id while production CT $_prod was '${_pst:-nowhere}'"
        exit 1
      fi
      printf 'stopped\n' > "$D/$id.status"; : > "$D/$id.veth"; exit 0
    fi
    # ssh failing, which is a different fact from anything about the container:
    # nothing was asked of it at all.
    [[ -f "$D/$id.sshdies" ]] && { echo "ssh: connect to host $host port 22: No route to host" >&2; exit 255; }
    sid="$(cat "$D/$id.rootsid" 2>/dev/null)"
    if [[ "$(storage_verdict_of "$NODE" "$sid")" == alive ]]; then
      violation "shut down CT $id while its storage '$sid' was ALIVE"
      exit 1
    fi
    # Blocked I/O is what makes a shutdown hang, and there are two ways for it
    # not to be blocked: this run unmounted the dead storage, or the mountpoint
    # was already gone when the run started - which is what the `gone` verdict
    # IS. Modelling only the first made a shutdown against an already-unmounted
    # storage hang in the fake and return in reality.
    if [[ ! -f "$N/storage/$sid.unmounted" \
       && "$(storage_verdict_of "$NODE" "$sid")" != gone ]]; then exit 124; fi
    [[ -f "$D/$id.stubborn" ]] && exit 124
    printf 'stopped\n' > "$D/$id.status"
    : > "$D/$id.veth"
    exit 0;;

  "mkdir -p /etc/pve/ketsync/evacuate && cat > "*)
    dry_forbids "wrote the evacuate record" || exit 1
    f="${c#*cat > }"; f="${f//\'/}"
    n="${f##*/}"; n="${n%.tsv}"
    [[ -f "$N/.rowo" ]] && { echo "mkdir: Read-only file system" >&2; exit 1; }
    mkdir -p "$PVE/ketsync/evacuate"; cat > "$(evac_file "$n")"; exit 0;;

  "cat /etc/pve/ketsync/evacuate/"*|"cat '/etc/pve/ketsync/evacuate/"*)
    f="${c#cat }"; f="${f%% *}"; f="${f//\'/}"
    n="${f##*/}"; n="${n%.tsv}"
    [[ -f "$(evac_file "$n")" ]] || exit 1
    cat "$(evac_file "$n")"; exit 0;;

  "rm -f /etc/pve/ketsync/evacuate/"*|"rm -f '/etc/pve/ketsync/evacuate/"*)
    dry_forbids "removed the evacuate record" || exit 1
    f="${c#rm -f }"; f="${f//\'/}"
    n="${f##*/}"; n="${n%.tsv}"
    rm -f "$(evac_file "$n")"; exit 0;;

  # ---- the record, in pmxcfs so one copy serves the whole cluster
  "mkdir -p /etc/pve/ketsync/isolate && cat > "*)
    dry_forbids "wrote the isolate record" || exit 1
    f="${c#*cat > }"; f="${f//\'/}"
    id="${f##*/}"; id="${id%.tsv}"
    [[ -f "$N/.rowo" ]] && { echo "mkdir: cannot create directory '/etc/pve/ketsync': Read-only file system" >&2; exit 1; }
    sid="$(cat "$D/$id.rootsid" 2>/dev/null)"
    if [[ "$(storage_verdict_of "$NODE" "$sid")" == alive ]]; then
      violation "wrote an isolate record for CT $id whose storage '$sid' is ALIVE"
      exit 1
    fi
    mkdir -p "$PVE/ketsync/isolate"
    if [[ -f "$N/.rectrunc" ]]; then
      # pmxcfs is a filesystem with a size limit and a network under it. A
      # write that returns 0 and lands as nothing is the case the read-back
      # exists for, and it is the one a scenario cannot reach by making the
      # write fail.
      cat >/dev/null; : > "$(rec_file "$id")"
    else
      cat > "$(rec_file "$id")"
    fi
    exit 0;;

  "cat /etc/pve/ketsync/isolate/"*|"cat '/etc/pve/ketsync/isolate/"*)
    f="${c#cat }"; f="${f%% *}"; f="${f//\'/}"
    id="${f##*/}"; id="${id%.tsv}"
    [[ -f "$(rec_file "$id")" ]] || exit 1
    cat "$(rec_file "$id")"; exit 0;;

  "rm -f /etc/pve/ketsync/isolate/"*|"rm -f '/etc/pve/ketsync/isolate/"*)
    dry_forbids "removed the isolate record" || exit 1
    f="${c#rm -f }"; f="${f//\'/}"
    id="${f##*/}"; id="${id%.tsv}"
    [[ -f "$N/.recstuck" ]] && { echo "rm: cannot remove: Read-only file system" >&2; exit 1; }
    rm -f "$(rec_file "$id")"; exit 0;;

  # ---- the one write this engine makes to a container
  "pct set "*--net*)
    dry_forbids "changed a container's network" || exit 1
    id="$(awk '{print $3}' <<<"$c")"
    nid="$(sed -n 's/.*--\(net[0-9][0-9]*\) .*/\1/p' <<<"$c")"
    line="${c#*--"$nid" }"; line="${line#\'}"; line="${line%\'}"
    [[ -f "$D/$id.status" ]] || { echo "Configuration file 'lxc/$id.conf' does not exist" >&2; exit 2; }
    # The 9<id> again: --cleanup takes it off the wire so a reboot cannot put
    # its address back. There is no record for it and its storage is alive -
    # neither rule below applies. Its own rule is that it must be STOPPED
    # first: moving a running container's bridge takes a live service off the
    # air without stopping it, which is the worst of both.
    if (( id >= 9000 )); then
      [[ "$(cat "$D/$id.status" 2>/dev/null)" == running ]] \
        && { violation "moved CT $id's network while it was RUNNING"; exit 1; }
      awk -v n="$nid" -v l="$nid: $line" '$0 ~ "^"n": " {print l; next} {print}' \
          "$D/$id.nets" > "$D/.nets.$$" && mv -f "$D/.nets.$$" "$D/$id.nets"
      exit 0
    fi
    sid="$(cat "$D/$id.rootsid" 2>/dev/null)"
    newbr="$(printf '%s' "$line" | tr ',' '\n' | sed -n 's/^bridge=//p' | head -1)"
    # The refusal this whole engine is built around. A storage that answered is
    # a container that is very likely serving somebody, and moving it onto the
    # bridge with no uplink is an outage caused by the tool meant to prevent
    # one.
    #
    # It is the DIRECTION that makes it that, not the write. --restore moves a
    # container the other way, off the isolated bridge, and the storage being
    # alive again is exactly when that is supposed to happen - a rule that
    # refused any write on a live storage would have called the whole way home
    # a violation, and no scenario would have noticed until one restored on a
    # fleet that had recovered.
    if [[ "$newbr" == "${SIM_MOCK_BRIDGE:-vmbr99}" \
       && "$(storage_verdict_of "$NODE" "$sid")" == alive ]]; then
      violation "moved CT $id onto $newbr while its storage '$sid' was ALIVE"
      exit 1
    fi
    # The record is the only copy of the bridge about to be overwritten. Moving
    # first and writing it down afterwards loses it for good if the run dies in
    # between - so the order is an invariant, not a preference.
    oldbr="$(sed -n "s/^$nid: .*/&/p" "$D/$id.nets" 2>/dev/null | tr ',' '\n' | sed -n 's/^bridge=//p' | head -1)"
    if [[ "$newbr" != "$oldbr" ]] && ! rec_exists "$id"; then
      violation "moved CT $id's $nid from '$oldbr' to '$newbr' with no record written first"
      exit 1
    fi
    # config always; kernel only when this node hotplugs. A node that writes
    # the config and does not apply it is exactly what P6 is for.
    awk -v n="$nid" -v l="$nid: $line" '$0 ~ "^"n": " {print l; next} {print}' \
        "$D/$id.nets" > "$D/.nets.$$" && mv -f "$D/.nets.$$" "$D/$id.nets"
    # net0 in the config is veth<id>i0 in the kernel. Keeping the two named
    # differently is not pedantry: the engine reads one from `pct config` and
    # the other from /sys/class/net, and P6 exists because they can disagree.
    if [[ ! -f "$N/.nohotplug" ]]; then
      ifn="veth${id}i${nid#net}"
      # On an OVS node the interface does not change master when it changes
      # bridge - it was on the datapath before and it is on the datapath
      # after. What moves is the ovsdb row. Writing the bridge into the master
      # column here instead would have made every OVS scenario pass by turning
      # the fake into a Linux-bridge node.
      if grep -q "^$ifn ovs-system\$" "$D/$id.veth" 2>/dev/null; then
        awk -v n="$ifn" -v b="$newbr" '$1==n {print n" "b; next} {print}' \
            "$N/ovs" > "$N/.ovs.$$" 2>/dev/null && mv -f "$N/.ovs.$$" "$N/ovs"
      else
        awk -v n="$ifn" -v b="$newbr" '$1==n {print n" "b; next} {print}' \
            "$D/$id.veth" > "$D/.veth.$$" 2>/dev/null && mv -f "$D/.veth.$$" "$D/$id.veth"
      fi
    fi
    exit 0;;

  # Allowed only for a 9<id>, and only stopped - both checked above and again
  # here, because this is the one command in the fake that cannot be undone.
  "pct destroy "*)
    dry_forbids "destroyed a container" || exit 1
    id="${c##*pct destroy }"; id="${id%% *}"
    [[ -f "$D/$id.status" ]] || { echo "Configuration file 'lxc/$id.conf' does not exist" >&2; exit 2; }
    [[ "$(cat "$D/$id.status")" == running ]] \
      && { violation "destroyed CT $id while it was RUNNING"; exit 1; }
    rm -f "$D/$id.status" "$D/$id.nets" "$D/$id.veth" "$D/$id.onboot" "$D/$id.rootsid"
    rm -f "$PVE/nodes/$NODE/lxc/$id.conf"
    exit 0;;

  "pct set "*--onboot*)
    dry_forbids "changed onboot" || exit 1
    id="$(awk '{print $3}' <<<"$c")"
    v="$(sed -n 's/.*--onboot \([0-9]*\).*/\1/p' <<<"$c")"
    [[ -f "$D/$id.status" ]] || { echo "Configuration file 'lxc/$id.conf' does not exist" >&2; exit 2; }
    printf '%s\n' "$v" > "$D/$id.onboot"; exit 0;;
esac

violation "command the simulator does not model on production node $host: $c"
exit 1
