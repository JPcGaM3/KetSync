#!/usr/bin/env bash
# B5. The one the whole unmount-before-resize rule is written for.
# shellcheck source=tests/sim/failback/lib.sh
. "$SIMLIB"
img=""; for a in "$@"; do [[ -f "$a" || "$a" == */images/* ]] && img="$a"; done
trace "resize2fs $*"
[[ -n "$img" && -n "$(loop_of "$img")" ]] && violation "resize2fs on a MOUNTED image: $img"
dry_forbids "resize2fs on $img"
exit 0
