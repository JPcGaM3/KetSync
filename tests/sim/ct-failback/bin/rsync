#!/usr/bin/env bash
# fake rsync: a promoted copy on the backup node -> the loop-mounted PRODUCTION
# image on this node. The opposite direction from ct-replica, and the dangerous
# one: what is at risk here is a live customer's rootfs, not a copy of it.
#
# So this is where the fake refuses to pretend the hardest. Five different
# disasters end up here, and each is a violation instead of a simulated
# transfer.
# shellcheck source=tests/sim/failback/lib.sh
. "$SIMLIB"
dst="${*: -1}"; dst="${dst%/}"; src="${*: -2:1}"; src="${src%/}"
logfile=""; wants_stats=0; deletes=0; dryrun=0; prog2=0
for a in "$@"; do
  case "$a" in
    --log-file=*) logfile="${a#--log-file=}";;
    --stats)      wants_stats=1;;
    --delete)     deletes=1;;
    -n|--dry-run) dryrun=1;;
    --info=progress2) prog2=1;;
  esac
done

# ---- the skeleton pass: the excluded directories, sent ENTRY-only -----------
# The mirror of ct-replica's: sources on the BACKUP node, destination the
# loop-mounted production image. Same contract - every source is anchored /./
# so -R rebuilds the path relative to the copy's root, and none may end in a
# slash: a slash sends the directory's CONTENTS, which needs the readdir the
# exclude exists to avoid. The B9 probe applies to this write like any other.
if [[ " $* " == *" -dogpR "* ]]; then
  _skel_dst="${*: -1}"; _skel_dst="${_skel_dst%/}"
  case "$_skel_dst" in
    */failback-*)
      _ict="${_skel_dst##*/failback-}"; _ict="${_ict%%/*}"
      flock -n "$SIMROOT/work/.ct-intake-$_ict.lock" true 2>/dev/null \
        && violation "skeleton write into CT $_ict's image while the intake lock (B9) is free";;
  esac
  { [[ -n "$(img_at "$_skel_dst")" ]] && is_mounted "$_skel_dst"; } \
    || violation "skeleton pass into $_skel_dst, which is not a loop-mounted image"
  for _a in "$@"; do
    case "$_a" in
      *:*/./*)
        _rel="${_a#*/./}"
        trace "rsyncdir $_rel"
        [[ "$_a" == */ ]] && violation "the skeleton pass sent '$_a' with a trailing slash - rsync would read the directory, which is the read that fails"
        _root="${_a#*:}"; _root="${_root%%/./*}"
        [[ -d "$BKP/fs$_root/${_rel%/}" ]] \
          || violation "skeleton source $_a does not exist on the backup node"
        dry_forbids "skeleton mkdir $_rel in the image"
        mkdir -p "$_skel_dst/${_rel%/}" || exit 1;;
      */./*)
        violation "skeleton source '$_a' is not remote - the directories come off the copy on the backup node";;
    esac
  done
  [[ -f "$SIMROOT/rsyncdir.fail" ]] && exit 23
  exit 0
fi

trace "rsync $src -> $dst"
# Every flag, recorded one per line. Without this the fake sees only src and
# dst, and the whole option set is untestable: stripping -x, --delete,
# --numeric-ids, --sparse and all six excludes left the suite 61/61 green.
# -x is the flag that keeps a 2T mp0 out of a rootfs image; it was correct
# in the tree and nothing would have said so on the day it stopped being.
for _a in "$@"; do case "$_a" in -*) trace "rsyncopt $_a";; esac; done

# The one rsync a dry run may make is one that cannot move a byte. Without
# -n this call has --delete and --inplace on it, so a run that called itself
# dry would empty and rewrite the customer's rootfs.
(( dryrun )) || dry_forbids "rsync without -n, $src -> $dst"

# B9: while these bytes can land in the production image, the intake lock must
# be HELD. ct-migrate fills this same image during an intake and ct-replica
# reads it live on a snapshotless storage; the flock is what makes the three
# take turns. Probed on every transfer rather than asserted per scenario: a
# write-back that runs while the lock is free is a violation even when every
# byte of it lands correctly.
case "$dst" in
  */failback-*)
    _ict="${dst##*/failback-}"; _ict="${_ict%%/*}"
    if flock -n "$SIMROOT/work/.ct-intake-$_ict.lock" true 2>/dev/null; then
      violation "write-back into CT $_ict's image while the intake lock (B9) is free"
    fi;;
esac

# The stats must come from --log-file, never from stdout: in a tty stdout is
# the human's progress bar, and under cron it is the progress filter's stream -
# either way a parser reading it gets progress updates mixed into its numbers.
(( wants_stats && ${#logfile} == 0 )) \
  && violation "rsync --stats without --log-file (stats could only come from stdout)"

# --- the destination must be the loop-mounted image, on a real filesystem ---
if [[ "$dst" == *:* ]]; then
  violation "rsync destination '$dst' is remote - this failback writes on THIS node"
  exit 1
fi
img="$(img_at "$dst")"
if [[ -z "$img" ]]; then
  # B5. A plain directory swallows the whole rootfs of a DR'd container and
  # puts it on whatever filesystem $MNT_BASE happens to live on.
  violation "rsync into $dst, which is not a loop-mounted image - the restore lands in a plain directory"
elif ! is_mounted "$dst"; then
  violation "rsync into $dst, which is not mounted"
else
  # B3. An unmounted backing dataset leaves an ordinary empty directory behind,
  # so "writing into the image" fills the node's root disk instead.
  [[ "$(fs_holder "$img")" == "/" ]] \
    && violation "rsync writes into $img, which sits on the node ROOT filesystem - B3"
  # B1, made executable. The image belongs to a container; if that container is
  # up on its own node then its rootfs is mounted there too, and this second
  # mount is ext4 corruption of the LIVE customer system.
  ct="$(ct_of_image "$img")" || ct=""
  if [[ -n "$ct" ]]; then
    st="$(prod_status "$ct")" || st="unreachable"
    [[ "$st" == "stopped" ]] \
      || violation "rsync into the image of CT $ct while it is '$st' - B1"
  fi
fi

# --- the source must be one promoted copy on the backup node ---
if [[ "$src" != *:* ]]; then
  violation "rsync source '$src' is not remote - the data is supposed to come off the backup node"
  exit 1
fi
rpath="${src#*:}"; rpath="${rpath%/}"
ds="$(bkp_ds_of "$rpath")"
if [[ -z "$ds" || "$(bkp_field "$ds" 2)" != "yes" ]]; then
  violation "rsync reads $rpath, which no MOUNTED dataset owns - that is an empty directory, and --delete would then empty the production image"
else
  base="${rpath##*/}"
  if [[ "$base" =~ ^subvol-([0-9]+)-disk-0$ ]]; then
    vmid="${BASH_REMATCH[1]}"
    cst="$(cat "$BKP/ct/$vmid.status" 2>/dev/null)"
    # B2. Every mode is legitimate; what is never legitimate is reading a copy
    # that NOTHING is shielding. Three things can shield one, and the invariant
    # is that at least one of them holds:
    #
    #   the copy RUNS               ct-replica R2 skips it
    #   PAUSE is in place           ct-replica does not run at all
    #   its 9<id> is live           ct-replica R13 skips it, for as long as
    #                               that container exists anywhere in pmxcfs
    #
    # Without one of those, the next cron tick overwrites the DR data with the
    # stale production image and this rsync then pulls that staleness back over
    # the customer's rootfs. R13 was not in this list while the engine only
    # knew about the first two, and the case it covers is the one a real
    # disaster on this fleet produces: nobody promotes the copy at all.
    if (( ! dryrun )); then
      _dr9=( "$BKP/fs/etc/pve/nodes"/*/lxc/"$(( vmid - 8000 + 9000 ))".conf )
      case "$cst" in
        running) ;;
        stopped) [[ -f "$SIMWORK/PAUSE" || -e "${_dr9[0]}" ]] \
                   || violation "rsync pulls from copy $vmid, which is STOPPED with no PAUSE and no live 9<id> - nothing is shielding it from the next cron tick";;
        *)       violation "rsync pulls from copy $vmid, which is '${cst:-unknown}'";;
      esac
    fi
  else
    violation "rsync source $rpath is not a per-copy subvol dataset - this would pull every copy under it into one image"
  fi
fi

# A scenario can interrupt this transfer. SIGINT goes to the engine, which is
# where Ctrl-C lands: bash defers it until the foreground child is reaped, then
# runs its EXIT trap and dies. Nothing after the rsync call runs - so whatever
# has to survive a kill (here: the loop-mount on a live customer image) must be
# in that trap.
if [[ -f "$SIMROOT/rsync.kill" ]]; then
  rm -f "$SIMROOT/rsync.kill"
  # a terminal signals the whole foreground process GROUP, and both halves are
  # needed: bash discards a SIGINT it took while a child was running if that
  # child exits normally, and keeps going if only the child was signalled.
  # The engine is no longer simply $PPID: under cron the rsync shim runs
  # inside a pipeline element (rsync | rs_progress), so the parent is a
  # subshell, not the engine. run_engine records the engine's own pid for
  # exactly this moment - signalling anything found by walking the process
  # tree was a guess that lost a race once.
  _eng="$(cat "$SIMROOT/engine.pid" 2>/dev/null)"
  kill -INT "${_eng:-$PPID}" 2>/dev/null
  kill -INT $$
  sleep 5                              # unreachable; here so a blocked signal shows
  exit 20
fi

n="$(cat "$SIMROOT/rsync.n" 2>/dev/null || echo 0)"
rc="$(awk -v i="$n" 'NR==1{print $(i+1)}' "$SIMROOT/rsync.rc" 2>/dev/null)"
[[ -z "$rc" ]] && rc=0
echo $(( n + 1 )) > "$SIMROOT/rsync.n"

# --info=progress2 writes carriage-return separated updates to stdout. Three in
# one burst, because that is the shape the engine's cron filter has to survive:
# the first must become ONE readable log line and the rest must be swallowed by
# the once-a-minute limit.
if (( prog2 )); then
  printf '     11,534,336   4%%   12.34MB/s    0:00:01\r  2,569,208,517  38%%   24.68MB/s    0:00:12\r  6,569,208,517 100%%   30.01MB/s    0:00:59 (xfr#161, to-chk=0/157957)\r'
  printf '\n'
fi

# real rsync writes its --stats block with THOUSANDS SEPARATORS, so the fake
# does too - a parser that forgets to strip commas is caught here instead of on
# a live CT. The block goes to STDOUT as well as the log file, exactly as real
# rsync sends it: the engine's filter can only be proven to drop the byte wall
# if the fake actually says it.
emit_stats(){
  read -r f_files f_lit f_sent f_total < <(cat "$SIMROOT/rsync.stats" 2>/dev/null \
    || echo "161 2469606195 2470127483 118111600640")
  commafy(){ sed -e :a -e 's/\(.*[0-9]\)\([0-9]\{3\}\)/\1,\2/;ta' <<<"$1"; }
  cat <<EOF
Number of files: 157,957 (reg: 133,163, dir: 18,610)
Number of created files: 0
Number of deleted files: 0
Number of regular files transferred: $(commafy "$f_files")
Total file size: $(commafy "$f_total") bytes
Total transferred file size: $(commafy "$f_lit") bytes
Literal data: $(commafy "$f_lit") bytes
Matched data: 0 bytes
File list size: 0
Total bytes sent: 3,271
Total bytes received: $(commafy "$f_sent")
EOF
}
(( wants_stats )) && emit_stats
if [[ -n "$logfile" ]]; then
  # Into the log file the way real rsync writes it: every line prefixed
  # "date time [pid] ". The bare block here kept a suite green while an
  # engine anchored its label match to the line start and read every fleet
  # transfer as files=0 changed=0B - the parser has to earn its numbers
  # against the real shape.
  emit_stats | sed "s/^/2026\/08\/28 16:51:48 [33790] /" >> "$logfile"
fi

# Move the data, so a scenario can prove the production image really did end up
# holding the DR generation. 11 is out of space: nothing lands. 23 is partial,
# and it leaves the image half-written - which is the whole reason rc 23 must
# never be counted as a success.
if (( ! dryrun )) && [[ -d "$dst" && ( "$rc" == 0 || "$rc" == 24 || "$rc" == 23 ) ]]; then
  (( deletes )) && find "$dst" -mindepth 1 -delete 2>/dev/null
  [[ -d "$BKP/fs$rpath" ]] && cp -a "$BKP/fs$rpath/." "$dst/" 2>/dev/null
fi
exit "$rc"
