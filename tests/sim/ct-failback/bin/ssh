#!/usr/bin/env bash
# fake ssh - two kinds of remote machine, reached the only way the engine can
# reach them: one shell command at a time.
#
#   $SIM_BKP_HOST      the backup node. Its filesystem is $SIMROOT/bkp/fs, so a
#                      scenario sets it up by writing files and asserts on them
#                      afterwards. /etc/pve is cluster-shared, which is why the
#                      engine reads the PRODUCTION configs from over here.
#   anything else      a production node, at $SIMROOT/nodes/<name>/. Its only
#                      job is to answer B1: is this container stopped.
#
# The engine reaches a production node by ADDRESS, having turned the pmxcfs
# name into one through nodes.map. So the host this fake is handed may be an
# IP, and it resolves that back through the same map - a scenario that writes
# no map gets the name, which is the documented fallback and is tested too.
#
# Every command the engine issues is answered on purpose. An unknown remote
# command is a violation rather than a polite exit 0: a new remote call that
# silently "succeeds" is how a simulator starts proving nothing.
# shellcheck source=tests/sim/failback/lib.sh
. "$SIMLIB"
host=""; ctl=""; declare -a cmd=()
while (( $# )); do
  case "$1" in
    -o) shift 2;;                       # every -o option, ControlPath included
    -O) ctl="${2:-}"; shift 2;;         # ssh -O exit <host>: tear a master down
    -c) shift 2;;                       # cipher list
    -*) shift;;
    *)  if [[ -z "$host" ]]; then host="${1#*@}"; else cmd+=("$1"); fi; shift;;
  esac
done
[[ -n "$ctl" ]] && exit 0               # control-socket housekeeping, nothing to model

c="${cmd[*]:-}"
trace "ssh $host :: $(printf '%s' "$c" | tr '\n' ' ')"

# ---------------------------------------------------------------- production
# A production node answers exactly one question, and B1 turns on the
# difference between "it said stopped" and "it did not answer".
#
# The engine addresses it by IP when nodes.map has a row, so map back the same
# way. An unmapped host is used verbatim, which is how the no-map fallback and
# a genuinely unresolvable name both arrive here.
if [[ "$host" != "${SIM_BKP_HOST:-}" ]]; then
  N="$SIMROOT/nodes/$host"
  if [[ ! -d "$N" && -f "$SIMWORK/nodes.map" ]]; then
    _n="$(awk -v i="$host" '$1!~/^#/ && $1==i{print $2; exit}' "$SIMWORK/nodes.map")"
    [[ -n "$_n" ]] && N="$SIMROOT/nodes/$_n"
  fi
  [[ -d "$N" && ! -f "$N/.down" ]] \
    || { echo "ssh: connect to host $host port 22: No route to host" >&2; exit 255; }
  case "$c" in
    "pct status "*)
      id="$(awk '{print $3}' <<<"$c")"; f="$N/ct/$id.status"
      [[ -f "$f" ]] || { echo "Configuration file 'lxc/$id.conf' does not exist" >&2; exit 2; }
      printf 'status: %s\n' "$(cat "$f")"; exit 0;;
    true) exit 0;;
  esac
  violation "command the simulator does not model on production node $host: $c"
  exit 1
fi

# ---------------------------------------------------------------- backup node
if [[ -f "$BKP/.down" ]]; then
  echo "ssh: connect to host $host port 22: No route to host" >&2; exit 255
fi

case "$c" in
  # ---- who this node is, in pmxcfs terms ----
  # /etc/pve/local is a symlink to nodes/<this node>. The engine reads it
  # rather than being told, so bkp_identity in the harness is the only place
  # the sandbox decides what the backup node is called.
  #
  # What comes back is what the engine's whole remote command produces, not
  # what readlink alone would: the sed that strips the "nodes/" prefix runs on
  # the far side, and this fake answers a command string rather than running a
  # shell. Printing the raw symlink here would hand the engine "nodes/bkp02",
  # which is not a node name and matches nothing.
  *"readlink /etc/pve/local"*)
    cat "$BKP/node" 2>/dev/null; exit 0;;

  # ---- B2: is the promoted copy up or down ----
  "pct status "*)
    id="$(awk '{print $3}' <<<"$c")"; f="$BKP/ct/$id.status"
    [[ -f "$f" ]] || { echo "Configuration file 'nodes/$(cat "$BKP/node" 2>/dev/null)/lxc/$id.conf' does not exist" >&2; exit 2; }
    printf 'status: %s\n' "$(cat "$f")"; exit 0;;

  # ---- where does the copy's data actually sit on that node ----
  "zfs get "*mountpoint*)
    ds="${c##* mountpoint }"; ds="${ds%% *}"
    m="$(bkp_field "$ds" 3)"
    [[ -z "$m" ]] && { echo "cannot open '$ds': dataset does not exist" >&2; exit 1; }
    printf '%s\n' "$m"; exit 0;;

  # ---- finding the production CT in the cluster filesystem ----
  "ls "*)
    a="${c#ls }"; a="${a%%2>*}"
    set -f; read -r -a pats <<<"$a"; set +f
    found=0
    for pat in "${pats[@]}"; do
      [[ "$pat" == -* ]] && continue
      # shellcheck disable=SC2206  # the glob is the point: /etc/pve/nodes/*/lxc
      hits=( "$BKP/fs"$pat )
      for f in "${hits[@]}"; do
        [[ -e "$f" ]] || continue
        printf '%s\n' "${f#"$BKP/fs"}"; found=1
      done
    done
    (( found )) || { echo "ls: cannot access: No such file or directory" >&2; exit 2; }
    exit 0;;

  # ---- B8: the copy lock, on the machine that holds the copy ---------------
  # A real file under the backup node's /run, not a polite "yes, you have it".
  # The claim being tested is that the DESTINATION decides who wins, so a fake
  # that answers TAKEN every time proves nothing about the only case the guard
  # exists for. Written to match ct-replica's R14 exactly - it is the same
  # lock, and if these two ever model it differently one of them is lying.
  *ketsync-ct-*.lock*)
    lf="$(printf '%s' "$c" | sed -n 's#.*\(/run/ketsync-ct-[0-9]*\.lock\).*#\1#p')"
    [[ -n "$lf" ]] || violation "B8: lock command with no /run/ketsync-ct-<id>.lock path: $c"
    # A backup node that answers everything else and drops this one connection.
    # Narrow on purpose: a node that is simply down never reaches B8.
    [[ -f "$BKP/lock.fail" ]] && { echo "ssh_exchange_identification: closed" >&2; exit 255; }
    mkdir -p "$BKP/fs/run"
    case "$c" in
      "if (set -C;"*)
        owner="${c#*\'%s\\n\' \'}"; owner="${owner%%\'*}"
        if [[ -e "$BKP/fs$lf" ]]; then
          echo KETSYNC_LOCK_HELD; cat "$BKP/fs$lf" 2>/dev/null; exit 0
        fi
        dry_forbids "copy lock $lf created on the backup node"
        printf '%s\n' "$owner" > "$BKP/fs$lf"
        trace "bkp lock take $lf"
        # A human clears what looks like a stale lock while this run is still
        # alive, and the next run takes it legitimately. From here on the file
        # names somebody else, and this run must leave it alone at the end.
        if [[ -s "$BKP/lock.steal" ]]; then
          cat "$BKP/lock.steal" > "$BKP/fs$lf"; trace "bkp lock stolen $lf"
        fi
        echo KETSYNC_LOCK_TAKEN; exit 0;;
      "grep -qxF"*)
        owner="${c#grep -qxF \'}"; owner="${owner%%\'*}"
        if [[ -f "$BKP/fs$lf" ]] && grep -qxF "$owner" "$BKP/fs$lf"; then
          rm -f "$BKP/fs$lf"; trace "bkp lock release $lf"; exit 0
        fi
        # The grep said no. Whether the rm still runs is decided by how the two
        # are joined, exactly as a real shell decides it: `&&` gates it, `;`
        # does not. Emulated rather than pattern-matched.
        case "$c" in
          *"&& rm -f"*) exit 1;;
        esac
        [[ -f "$BKP/fs$lf" ]] && \
          violation "B8: the release removed $lf, which says: $(cat "$BKP/fs$lf")"
        rm -f "$BKP/fs$lf"; exit 0;;
      "cat "*)
        trace "bkp lock peek $lf"
        [[ -f "$BKP/fs$lf" ]] && cat "$BKP/fs$lf"
        exit 0;;
      *"rm "*)
        violation "B8: a release that removes $lf without asserting who owns it"
        rm -f "$BKP/fs$lf"; exit 0;;
    esac
    violation "B8: lock command shape the simulator does not model: $c"
    exit 1;;

  # ---- skeleton pass: which excluded directories exist on the copy ----------
  # The engine expands the exclude list's directory patterns HERE, on the node
  # that holds the copy, because during a failback the copy is where the truth
  # about "which users exist" lives. Read-only, so a dry run may make it too.
  # Emulated rather than pattern-matched: the fake cd's into the copy and lets
  # the same glob expand, [ -d ] and all, so an unmatched pattern stays out of
  # the answer exactly the way a real remote shell keeps it out.
  "cd '"*'[ -d '*)
    _sd="${c#cd \'}"; _sd="${_sd%%\'*}"
    _pats="${c#*for d in }"; _pats="${_pats%%;*}"
    trace "bkp skeldirs $_sd :: $_pats"
    if [[ -f "$BKP/skeldirs.fail" ]]; then
      echo "ssh: connect to host $host port 22: Connection timed out" >&2; exit 255
    fi
    if cd "$BKP/fs$_sd" 2>/dev/null; then
      for d in $_pats; do [ -d "$d" ] && printf '%s\n' "$d"; done
    fi
    exit 0;;

  "cat "*)
    f="${c#cat }"; f="${f%% *}"
    [[ -f "$BKP/fs$f" ]] || exit 1
    cat "$BKP/fs$f"; exit 0;;

  true) exit 0;;
esac

violation "remote command the simulator does not model: $c"
exit 1
