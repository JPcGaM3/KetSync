#!/usr/bin/env bash
# B5. Repairing the filesystem inside a mounted image is the same corruption
# the resize is, one step earlier.
# shellcheck source=tests/sim/failback/lib.sh
. "$SIMLIB"
img=""; for a in "$@"; do [[ -f "$a" || "$a" == */images/* ]] && img="$a"; done
trace "e2fsck $*"
[[ -n "$img" && -n "$(loop_of "$img")" ]] && violation "e2fsck on a MOUNTED image: $img"
dry_forbids "e2fsck -fp on $img"
exit 0
