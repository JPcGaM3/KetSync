#!/usr/bin/env bash
. "$SIMLIB"
dst="${@: -1}"; src="${@: -2:1}"; dst="${dst%/}"
trace "rsync $src -> $dst"
# Every flag, recorded one per line. Without this the fake sees only src and
# dst, and the whole option set is untestable: stripping -x, --delete,
# --numeric-ids, --sparse and all six excludes left the suite 61/61 green.
# -x is the flag that keeps a 2T mp0 out of a rootfs image; it was correct
# in the tree and nothing would have said so on the day it stopped being.
for _a in "$@"; do case "$_a" in -*) trace "rsyncopt $_a";; esac; done
# THE invariant this whole tool exists to protect: never write into a path that
# is not the loop-mounted image. If this fires, a CT landed on the node root fs.
is_mounted "$dst" || violation "rsync into a NON-MOUNTED destination: $dst"

logfile=""; wants_stats=0; dryrun=0
for a in "$@"; do
  case "$a" in
    --log-file=*) logfile="${a#--log-file=}";;
    --stats)      wants_stats=1;;
    -n|--dry-run) dryrun=1;;
  esac
done
# The one rsync a dry run may make is one that cannot move a byte. Without -n
# this call carries --delete, so a run that called itself dry would empty and
# refill the image it was only supposed to measure.
(( dryrun )) || dry_forbids "rsync without -n, $src -> $dst"
# The engine must never put rsync in a pipeline to read its stats: that takes
# stdout away from --info=progress2 and the human loses the progress bar. So if
# it asked for stats, it must have asked for a --log-file to put them in.
(( wants_stats && ${#logfile} == 0 )) && \
  violation "rsync --stats without --log-file (stats could only come from stdout)"

# A scenario can ask for this transfer to be interrupted. SIGINT goes to the
# engine, which is exactly where Ctrl-C lands: bash defers it until the
# foreground child is reaped, then runs its EXIT trap and dies. Nothing after
# the rsync call runs - so whatever has to survive a kill must be in that trap.
# One shot, so the next row (or an ENOSPC retry) is not killed as well.
if [[ -f "$SIMROOT/rsync.kill" ]]; then
  rm -f "$SIMROOT/rsync.kill"
  # A terminal sends SIGINT to the whole foreground process GROUP, so both of
  # these happen, and both are needed: bash discards a SIGINT it received while
  # a child was running if that child then exits normally, and it keeps going if
  # the child dies of SIGINT but the shell itself was never signalled. Only the
  # pair together makes bash run its EXIT trap and die - the real Ctrl-C.
  kill -INT "$PPID" 2>/dev/null       # ... to the shell
  kill -INT $$                        # ... and to the transfer
  sleep 5                             # unreachable; here so a blocked signal shows up
  exit 20
fi

n=$(cat "$SIMROOT/rsync.n" 2>/dev/null || echo 0)
rc=$(awk -v i="$n" 'NR==1{print $(i+1)}' "$SIMROOT/rsync.rc" 2>/dev/null)
[[ -z "$rc" ]] && rc=0
echo $(( n + 1 )) > "$SIMROOT/rsync.n"

# Real rsync writes its --stats block with THOUSANDS SEPARATORS in the numbers.
# The fake keeps them, so a parser that forgets to strip commas is caught here
# instead of on a live CT.
#
# The big number goes on "Total bytes RECEIVED", because ct-migrate.sh PULLS:
# its source is root@<old node>:/..., so the local rsync is the receiver and
# the sent line carries the file list and the checksums - a few kilobytes,
# whatever the size of the container. This fake had it the other way round for
# months, which is exactly why the engine reading the wrong line stayed green:
# a fake that is wrong in the same direction as the engine tests nothing.
if [[ -n "$logfile" ]]; then
  read -r f_files f_lit f_sent f_total < <(cat "$SIMROOT/rsync.stats" 2>/dev/null \
    || echo "161 2469606195 2470127483 118111600640")
  commafy(){ echo "$1" | sed -e :a -e 's/\(.*[0-9]\)\([0-9]\{3\}\)/\1,\2/;ta'; }
  cat >> "$logfile" <<EOF
Number of files: 157,957 (reg: 133,163, dir: 18,610)
Number of created files: 0
Number of deleted files: 0
Number of regular files transferred: $(commafy "$f_files")
Total file size: $(commafy "$f_total") bytes
Total transferred file size: $(commafy "$f_lit") bytes
Literal data: $(commafy "$f_lit") bytes
Matched data: 0 bytes
File list size: 0
File list generation time: 0.001 seconds
File list transfer time: 0.000 seconds
Total bytes sent: 3,271
Total bytes received: $(commafy "$f_sent")
EOF
fi
exit "$rc"
