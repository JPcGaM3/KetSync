#!/usr/bin/env bash
# fake ssh - the whole backup node, reached the only way the engine can reach
# it: one shell command at a time. The remote filesystem is $SIMROOT/bkp/fs, so
# a scenario sets the backup node up by writing files and asserts on them
# afterwards.
#
# Everything the engine asks for is answered here on purpose. An unknown remote
# command is a violation rather than a polite exit 0: a new remote call that
# silently "succeeds" is how a simulator starts proving nothing.
# shellcheck source=tests/sim/replica/lib.sh
. "$SIMLIB"
host=""; ctl=""; ctlpath=""; declare -a cmd=()
while (( $# )); do
  case "$1" in
    -o) [[ "${2:-}" == ControlPath=* ]] && ctlpath="${2#ControlPath=}"
        shift 2;;
    -O) ctl="${2:-}"; shift 2;;         # ssh -O exit <host>: tear a master down
    -c) shift 2;;                       # cipher list
    -*) shift;;
    *)  if [[ -z "$host" ]]; then host="${1#*@}"; else cmd+=("$1"); fi; shift;;
  esac
done
# Which socket this invocation multiplexes through is not cosmetic. Two lanes
# run concurrently under cron and each one's cleanup closes the masters it
# finds; a socket name without the pid in it is shared, so the lane that
# finishes first tears down the connection the other lane is still using and
# that lane dies mid-run. Nothing else in the sandbox can see the path, so it is
# recorded here - control commands included, rather than swallowed silently.
kind=cmd; [[ -n "$ctl" ]] && kind="-O $ctl"
printf '%s\t%s\n' "$kind" "${ctlpath:-<none>}" >> "$SIMROOT/ctlpath"
[[ -n "$ctl" ]] && exit 0               # control-socket housekeeping, nothing else to model

c="${cmd[*]:-}"
trace "ssh $host :: $(printf '%s' "$c" | tr '\n' ' ')"
if [[ -f "$BKP/.down" ]]; then
  echo "ssh: connect to host $host port 22: No route to host" >&2; exit 255
fi

case "$c" in
  # ---- anything whose program is zfs: RUN it, do not read it ---------------
  # The remote command goes through a real bash with the backup node's own fake
  # zfs first on PATH. That is deliberate: `zfs send | zfs recv` is a pipe whose
  # two halves fail independently, and the snapshot prune is
  # `list | grep | sort | head -n -N | while destroy`. A fake that matched the
  # text and decided what it meant would be testing its own reading of those,
  # not them. The exported shell functions the harness uses to reach the
  # STORAGE node's fakes have to go first, or `zfs` in here resolves to the
  # wrong machine's pool.
  *"zfs "*)
    unset -f zfs mount umount mountpoint findmnt losetup truncate resize2fs e2fsck pvesm rsync df hostname ssh
    PATH="$SIMBIN/bkp:$PATH" bash -c "$c"
    exit $?;;

  # ---- who is this machine, really (the preflight before anything runs) ----
  *"readlink /etc/pve/local"*)
    n="$(cat "$BKP/node" 2>/dev/null)"
    [[ -n "$n" ]] && printf 'NODE=%s\n' "$n"
    printf 'NODES=%s\n' "$(cat "$BKP/nodes" 2>/dev/null)"
    exit 0;;

  # ---- R9: does the mock bridge exist, and does anything on it reach a wire?
  # This reproduces the engine's own remote snippet, including the fact that a
  # missing bridge exits before it can echo OK.
  *"ip -br link show"*)
    [[ -f "$BKP/r9.fail" ]] && { echo "ssh_exchange_identification: closed" >&2; exit 255; }
    br="${c#*ip -br link show }"; br="${br%%[[:space:]]*}"
    [[ -f "$BKP/bridges/$br" ]] || { echo MISSING; exit 0; }
    while read -r port kind members; do
      [[ -z "${port:-}" ]] && continue
      # An OVS bond is one PORT whose members are the NICs, and it has no
      # kernel netdev of its own - so `list-ports` names something with no
      # /device and no /bonding, and R9 would call a bridge with a bonded
      # uplink isolated. `list-ifaces` returns the members. The fake answers
      # the two differently because ovs-vsctl does.
      if [[ "$kind" == ovsbond ]]; then
        [[ "$c" == *list-ifaces* ]] || continue
        for m in ${members//,/ }; do printf 'UPLINK %s\n' "$m"; done
        continue
      fi
      case "$kind" in nic|bond) printf 'UPLINK %s\n' "$port";; esac
    done < "$BKP/bridges/$br"
    echo OK; exit 0;;

  # ---- AUTO_DISCOVER ----
  *"pvesh get /cluster/resources"*)
    cat "$BKP/resources.json" 2>/dev/null; exit 0;;

  # ---- is the destination storage id there at all ----
  "pvesm status "*)
    sid="${c##*--storage }"; sid="${sid%% *}"
    s="$(sed -n 1p "$BKP/storage/$sid" 2>/dev/null)" \
      || { echo "storage '$sid' does not exist" >&2; exit 255; }
    echo "Name             Type     Status           Total            Used       Available        %"
    echo "$sid          zfspool   $s      10737418240      1073741824      9663676416    10.00%"
    exit 0;;

  # ---- the config lock, both directions of R15 ----
  # `pct set --lock` refuses a guest that is already locked - that refusal IS
  # vzdump winning the race, so the fake reproduces it rather than clobbering.
  "pct set "*--lock*)
    id="$(awk '{print $3}' <<<"$c")"; val="${c##*--lock }"; val="${val%% *}"
    f="$BKP/fs/etc/pve/nodes/$(cat "$BKP/node")/lxc/$id.conf"
    [[ -f "$f" ]] || { echo "Configuration file '$id.conf' does not exist" >&2; exit 2; }
    grep -q '^lock:' "$f" && { echo "CT is locked ($(sed -n 's/^lock: *//p' "$f"))" >&2; exit 25; }
    # the race a scenario cannot stage from outside: vzdump acquires between
    # the engine's R15 read of the config and this set
    [[ -f "$BKP/lockrace" ]] && { rm -f "$BKP/lockrace"; echo "CT is locked (backup)" >&2; exit 25; }
    dry_forbids "pct set $id --lock on the backup node"
    printf 'lock: %s\n' "$val" >> "$f"; trace "bkp cfglock $id $val"; exit 0;;
  "pct unlock "*)
    id="$(awk '{print $3}' <<<"$c")"
    f="$BKP/fs/etc/pve/nodes/$(cat "$BKP/node")/lxc/$id.conf"
    dry_forbids "pct unlock $id on the backup node"
    [[ -f "$f" ]] && { grep -v '^lock:' "$f" > "$f.n"; mv -f "$f.n" "$f"; }
    trace "bkp cfgunlock $id"; exit 0;;

  # ---- R2 ----
  "pct status "*)
    id="$(awk '{print $3}' <<<"$c")"; f="$BKP/ct/$id.status"
    [[ -f "$f" ]] || { echo "Configuration file 'nodes/$(cat "$BKP/node")/lxc/$id.conf' does not exist" >&2; exit 2; }
    printf 'status: %s\n' "$(cat "$f")"; exit 0;;
  "pct list"*)
    printf '%10s %-10s %-20s\n' VMID Status Name
    for f in "$BKP"/ct/*.status; do
      [[ -e "$f" ]] || continue
      id="${f##*/}"; id="${id%.status}"
      printf '%10s %-10s %-20s\n' "$id" "$(cat "$f")" "copy-$id"
    done
    exit 0;;

  # ---- reading /etc/pve ----
  "ls "*)
    a="${c#ls }"; a="${a%%2>*}"
    set -f; read -r -a pats <<<"$a"; set +f
    found=0
    for pat in "${pats[@]}"; do
      [[ "$pat" == -* ]] && continue
      # shellcheck disable=SC2206  # the glob is the point: /etc/pve/nodes/*/lxc
      hits=( "$BKP/fs"$pat )
      for f in "${hits[@]}"; do
        [[ -e "$f" ]] || continue
        printf '%s\n' "${f#"$BKP/fs"}"; found=1
      done
    done
    (( found )) || { echo "ls: cannot access: No such file or directory" >&2; exit 2; }
    exit 0;;

  # ---- writing the copy config ----
  "cat > "*)
    f="${c#cat > }"; f="${f%% *}"
    tgt="${f##*/}"; tgt="${tgt%.conf}"
    body="$(cat)"
    if [[ ! -d "$BKP/fs${f%/*}" ]]; then
      echo "-bash: $f: No such file or directory" >&2; exit 1
    fi
    [[ -f "$BKP/cfgwrite.fail" ]] && { echo "$f: Input/output error" >&2; exit 1; }
    # A copy carries a production IP and MAC. The only thing that keeps that
    # harmless is the bridge it sits on, so a config that names any other
    # bridge is a live duplicate of a customer host waiting to be started.
    while IFS= read -r l; do
      case "$l" in
        net[0-9]*:*)
          [[ "$l" == *bridge=* ]] || continue
          b="${l#*bridge=}"; b="${b%%,*}"
          [[ "$b" == "${SIM_MOCK_BRIDGE:-vmbr99}" ]] \
            || violation "copy config $tgt puts $l on bridge '$b', not the isolated ${SIM_MOCK_BRIDGE:-vmbr99}";;
        onboot:*)
          [[ "${l#onboot: }" == 0 ]] \
            || violation "copy config $tgt has '$l' - a copy that boots itself is a second live host";;
      esac
    done <<<"$body"
    # A write cut short is SILENT: stdin is consumed, the status is 0, and only
    # part of the text arrives. That is what this reproduces, not a write error.
    dry_forbids "copy config write to $f on the backup node"
    if grep -qxF "$tgt" "$SIMROOT/cfgwrite.trunc" 2>/dev/null; then
      printf '%s' "$body" | head -c 40 > "$BKP/fs$f"
    else
      printf '%s\n' "$body" > "$BKP/fs$f"
    fi
    exit 0;;

  # ---- R14: the copy lock, on the machine that holds the copy --------------
  # A real file under the backup node's /run, not a polite "yes, you have it".
  # The whole claim of this guard is that the DESTINATION decides who wins, so
  # a fake that answers TAKEN every time proves nothing about the only case it
  # exists for. Two runs against one sandbox therefore contend for real.
  *ketsync-ct-*.lock*)
    lf="$(printf '%s' "$c" | sed -n 's#.*\(/run/ketsync-ct-[0-9]*\.lock\).*#\1#p')"
    [[ -n "$lf" ]] || violation "R14: lock command with no /run/ketsync-ct-<id>.lock path: $c"
    # A backup node that answers everything else and drops this one connection.
    # Narrow on purpose: a node that is simply down never reaches R14, because
    # R9 refuses the whole run first. What R14 has to survive is the transient.
    [[ -f "$BKP/lock.fail" ]] && { echo "ssh_exchange_identification: closed" >&2; exit 255; }
    mkdir -p "$BKP/fs/run"
    case "$c" in
      "if (set -C;"*)
        owner="${c#*\'%s\\n\' \'}"; owner="${owner%%\'*}"
        if [[ -e "$BKP/fs$lf" ]]; then
          echo KETSYNC_LOCK_HELD; cat "$BKP/fs$lf" 2>/dev/null; exit 0
        fi
        dry_forbids "copy lock $lf created on the backup node"
        printf '%s\n' "$owner" > "$BKP/fs$lf"
        trace "bkp lock take $lf"
        # A human clears what looks like a stale lock while this run is still
        # alive, and the next run takes it legitimately. From here on the file
        # says somebody else's name, and this run must not remove it at the
        # end. Arranged by the scenario rather than asserted on the shape of
        # the command, so a release that removes the file for any other reason
        # is caught too.
        if [[ -s "$BKP/lock.steal" ]]; then
          cat "$BKP/lock.steal" > "$BKP/fs$lf"; trace "bkp lock stolen $lf"
        fi
        echo KETSYNC_LOCK_TAKEN; exit 0;;
      "grep -qxF"*)
        owner="${c#grep -qxF \'}"; owner="${owner%%\'*}"
        if [[ -f "$BKP/fs$lf" ]] && grep -qxF "$owner" "$BKP/fs$lf"; then
          rm -f "$BKP/fs$lf"; trace "bkp lock release $lf"; exit 0
        fi
        # The grep said no. Whether the rm still runs is decided by how the two
        # are joined, exactly as a real shell would decide it: `&&` gates it,
        # `;` does not. Emulated rather than pattern-matched, because the bug
        # worth catching is a release that removes a lock a LIVE transfer on
        # another machine is relying on - and with `;` that is what it does.
        case "$c" in
          *"&& rm -f"*) exit 1;;      # gated: somebody else's, or already gone
        esac
        [[ -f "$BKP/fs$lf" ]] && \
          violation "R14: the release removed $lf, which says: $(cat "$BKP/fs$lf")"
        rm -f "$BKP/fs$lf"; exit 0;;
      "cat "*)
        trace "bkp lock peek $lf"
        [[ -f "$BKP/fs$lf" ]] && cat "$BKP/fs$lf"
        exit 0;;
      *"rm "*)
        # Judged on SHAPE, not on who happens to own the file at the time: a
        # release that does not name an owner is one a human clearing a stale
        # lock turns into "delete the run that legitimately replaced me". That
        # it usually removes the right file is exactly why it would survive.
        violation "R14: a release that removes $lf without asserting who owns it"
        rm -f "$BKP/fs$lf"; exit 0;;
    esac
    violation "R14: lock command shape the simulator does not model: $c"
    exit 1;;

  "cat "*)
    f="${c#cat }"; f="${f%% *}"
    [[ -f "$BKP/fs$f" ]] || exit 1
    cat "$BKP/fs$f"; exit 0;;

  true) exit 0;;
esac

violation "remote command the simulator does not model: $c"
exit 1
