#!/usr/bin/env bash
# fake rsync: a loop-mounted image on this node -> a dataset on the backup node.
#
# This is where the run either works or destroys something, so this is where the
# fake refuses to pretend the hardest. Four different disasters end up here, and
# each of them is a violation instead of a simulated transfer.
# shellcheck source=tests/sim/replica/lib.sh
. "$SIMLIB"
dst="${*: -1}"; src="${*: -2:1}"; src="${src%/}"
logfile=""; wants_stats=0; deletes=0; dryrun=0; exclfile=""; del_excluded=0
for a in "$@"; do
  case "$a" in
    --log-file=*)    logfile="${a#--log-file=}";;
    --exclude-from=*) exclfile="${a#--exclude-from=}";;
    --stats)         wants_stats=1;;
    --delete)        deletes=1;;
    # The flag that turns the protection off. Modelled because a mutation adds
    # it: without it here, "the destination's own .zfs is deleted" would be a
    # mutation nothing could notice.
    --delete-excluded) deletes=1; del_excluded=1;;
    -n|--dry-run)    dryrun=1;;
  esac
done
trace "rsync $src -> $dst"
# Every flag, recorded one per line. Without this the fake sees only src and
# dst, and the whole option set is untestable: stripping -x, --delete,
# --numeric-ids, --sparse and all six excludes left the suite 61/61 green.
# -x is the flag that keeps a 2T mp0 out of a rootfs image; it was correct
# in the tree and nothing would have said so on the day it stopped being.
for _a in "$@"; do case "$_a" in -*) trace "rsyncopt $_a";; esac; done

# --- the exclude list ---------------------------------------------------------
# Recorded by CONTENT, not by filename: what a scenario cares about is which
# patterns reached rsync, and the file is in a temp sandbox whose path nothing
# should have to spell. Real rsync ignores blanks and #-comments in this file,
# so the fake does too - a comment being read as a pattern would silently stop
# a real path from being copied.
EXPATS=()
if [[ -n "$exclfile" ]]; then
  if [[ ! -r "$exclfile" ]]; then
    violation "rsync --exclude-from=$exclfile, which does not exist - rsync would refuse and nothing would be copied"
  else
    while IFS= read -r _p; do
      [[ -z "$_p" || "$_p" == \#* || "$_p" == \;* ]] && continue
      EXPATS+=("$_p"); trace "rsyncexclude $_p"
    done < "$exclfile"
  fi
fi

# The one rsync a dry run may make is one that cannot move a byte. Without -n
# this call carries --delete, so a run that called itself dry would empty the
# copy it was only supposed to measure.
(( dryrun )) || dry_forbids "rsync without -n, $src -> $dst"

# The engine must never put rsync in a pipeline to read its stats: that takes
# stdout away from --info=progress2 and the operator loses the progress bar. So
# if it asked for stats it must have asked for a file to put them in.
(( wants_stats && ${#logfile} == 0 )) \
  && violation "rsync --stats without --log-file (stats could only come from stdout)"

# --- the source must be the loop-mount, so the bytes are the snapshot's ---
img="$(img_at "$src")"
if [[ -z "$img" ]]; then
  violation "rsync reads $src, which is not a loop-mounted image"
else
  holder="$(fs_holder "$img")"
  if [[ "$(fs_field "$holder" 2)" == "zfs" && "$(zfs_type "$(fs_field "$holder" 3)")" != "clone" ]]; then
    violation "rsync carries $img off the LIVE dataset instead of the clone - R1"
  fi
fi

# --- the destination has to be the backup node, and a real place on it ---
if [[ "$dst" != *:* ]]; then
  violation "rsync destination '$dst' is not remote - this would copy onto the storage node itself"
  exit 1
fi
rpath="${dst#*:}"; rpath="${rpath%/}"
ds="$(bkp_ds_of "$rpath")"
if [[ -z "$ds" || "$(bkp_field "$ds" 2)" != "yes" ]]; then
  # R3. An unmounted dataset is just a directory on the backup node's root
  # filesystem, and a whole CT is about to be poured into it.
  violation "rsync into $rpath, which no MOUNTED dataset owns - this fills the backup node's ROOT fs"
else
  base="${rpath##*/}"
  if [[ "$base" =~ ^subvol-([0-9]+)-disk-0$ ]]; then
    vmid="${BASH_REMATCH[1]}"
    # R2. A running copy means DR was promoted and this is the live system now.
    [[ "$(cat "$BKP/ct/$vmid.status" 2>/dev/null)" == running ]] \
      && violation "rsync into copy $vmid while it is RUNNING - that is the promoted DR system"
    # R4's job, and the one G7 does for ct-migrate: --delete into a dataset some
    # OTHER guest boots from empties that guest instead of this copy. The only
    # config allowed to name this volume is this copy's own, on the backup node.
    mine="$BKP/fs/etc/pve/nodes/$(cat "$BKP/node" 2>/dev/null)/lxc/$vmid.conf"
    for f in "$BKP/fs"/etc/pve/nodes/*/lxc/*.conf "$BKP/fs"/etc/pve/nodes/*/qemu-server/*.conf; do
      [[ -e "$f" && "$f" != "$mine" ]] || continue
      grep -qE "^rootfs:.*[:/]$base(,|\$)" "$f" \
        && violation "rsync --delete into $rpath, which is the rootfs of ${f#"$BKP/fs"/etc/pve/nodes/}"
    done
  else
    violation "rsync destination $rpath is not a per-copy subvol dataset - --delete here hits every copy under it"
  fi
fi

# A scenario can interrupt this transfer. SIGINT goes to the engine, which is
# where Ctrl-C lands: bash defers it until the foreground child is reaped, then
# runs its EXIT trap and dies. Nothing after the rsync call runs - so whatever
# has to survive a kill (the loop-mount, the clone) must be in that trap.
if [[ -f "$SIMROOT/rsync.kill" ]]; then
  rm -f "$SIMROOT/rsync.kill"
  # a terminal signals the whole foreground process GROUP, and both halves are
  # needed: bash discards a SIGINT it took while a child was running if that
  # child exits normally, and keeps going if only the child was signalled.
  kill -INT "$PPID" 2>/dev/null
  kill -INT $$
  sleep 5                              # unreachable; here so a blocked signal shows
  exit 20
fi

n="$(cat "$SIMROOT/rsync.n" 2>/dev/null || echo 0)"
rc="$(awk -v i="$n" 'NR==1{print $(i+1)}' "$SIMROOT/rsync.rc" 2>/dev/null)"
[[ -z "$rc" ]] && rc=0
echo $(( n + 1 )) > "$SIMROOT/rsync.n"

# real rsync writes its --stats block with THOUSANDS SEPARATORS, so the fake
# does too - a parser that forgets to strip commas is caught here instead of on
# a live CT.
if [[ -n "$logfile" ]]; then
  read -r f_files f_lit f_sent f_total < <(cat "$SIMROOT/rsync.stats" 2>/dev/null \
    || echo "161 2469606195 2470127483 118111600640")
  commafy(){ sed -e :a -e 's/\(.*[0-9]\)\([0-9]\{3\}\)/\1,\2/;ta' <<<"$1"; }
  cat >> "$logfile" <<EOF
Number of files: 157,957 (reg: 133,163, dir: 18,610)
Number of created files: 0
Number of deleted files: 0
Number of regular files transferred: $(commafy "$f_files")
Total file size: $(commafy "$f_total") bytes
Total transferred file size: $(commafy "$f_lit") bytes
Literal data: $(commafy "$f_lit") bytes
Matched data: 0 bytes
File list size: 0
Total bytes sent: $(commafy "$f_sent")
Total bytes received: 3,271
EOF
fi

# move the data, so a scenario can prove WHERE the copy came from. 11 is out of
# space: nothing lands. 23 is partial; the destination is left half-written,
# which is exactly why rc 23 must never be treated as a success.
d="$BKP/fs$rpath"
if (( ! dryrun )) && [[ -d "$d" && ( "$rc" == 0 || "$rc" == 24 || "$rc" == 23 ) ]]; then
  # What rsync EXCLUDES it also does not delete - that is the default, and
  # `--delete-excluded` is the flag you would have to add to change it. It is
  # the half of the exclude list that matters at the destination: the copy's
  # own `.zfs` control directory has no counterpart in the source, and a
  # --delete that could see it would spend the night failing to remove a
  # read-only snapshot tree.
  PROTECTED=()
  (( del_excluded )) || for _p in ${EXPATS+"${EXPATS[@]}"}; do
    [[ "$_p" == /* ]] || continue
    # shellcheck disable=SC2086,SC2115  # the glob IS the pattern
    for _m in ${d}${_p}; do [[ -e "$_m" ]] && PROTECTED+=("$_m"); done
  done
  if (( deletes )); then
    if (( ${#PROTECTED[@]} )); then
      _pr=(); for _m in "${PROTECTED[@]}"; do _pr+=( -path "$_m" -o ); done
      unset '_pr[${#_pr[@]}-1]'
      find "$d" -mindepth 1 \( "${_pr[@]}" \) -prune -o -print0 2>/dev/null \
        | xargs -0 rm -rf -- 2>/dev/null
    else
      find "$d" -mindepth 1 -delete 2>/dev/null
    fi
  fi
  [[ -d "$src" ]] && cp -a "$src/." "$d/" 2>/dev/null
  # The excludes are APPLIED to what arrives, not merely counted. A pattern
  # that reached rsync and changed nothing is a pattern nobody would notice
  # going missing, and the whole point of moving this list into a file is that
  # a site edits it. Anything that was PROTECTED above is put back: it was
  # never sent, and it was never deleted either.
  for _p in ${EXPATS+"${EXPATS[@]}"}; do
    [[ "$_p" == /* ]] || continue          # relative patterns match anywhere: not modelled
    for _m in ${d}${_p}; do
      case " ${PROTECTED[*]:-} " in *" $_m "*) continue;; esac
      rm -rf "$_m" 2>/dev/null
    done
  done
fi
exit "$rc"
